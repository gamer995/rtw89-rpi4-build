From: rtw89-usb-ap-fix <local@patch>
Date: Fri, 15 May 2026 11:40:00 +0800
Subject: [PATCH] rtw89: skip MAC flush timeout paths for USB AP mode

RTL8922AU on Raspberry Pi 4/iStoreOS can reliably hit
"timed out to flush queues" from MAC-level DLE flushes while running as
a USB AP. The key-disable path was not enough; mac80211 also calls
ops_flush during station teardown, and core_stop can hit the same
MAC-level flush while reloading Wi-Fi.

Keep the HCI-level USB flush, but skip rtw89_mac_flush_txq() for USB AP
teardown paths. This avoids corrupting MAC/DLE state after client
disconnects, which otherwise can stop beaconing and make the SSID
disappear.
---
diff --git a/core.c b/core.c
--- a/core.c
+++ b/core.c
@@ -5912,7 +5912,8 @@ void rtw89_core_stop(struct rtw89_dev *rtwdev)
 
 	rtw89_btc_ntfy_poweroff(rtwdev);
 	rtw89_hci_flush_queues(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
-	rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
+	if (rtwdev->hci.type != RTW89_HCI_TYPE_USB)
+		rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
 	rtw89_hci_stop(rtwdev);
 	rtw89_hci_deinit(rtwdev);
 	rtw89_mac_pwr_off(rtwdev);
diff --git a/mac80211.c b/mac80211.c
--- a/mac80211.c
+++ b/mac80211.c
@@ -954,6 +954,19 @@ static int rtw89_ops_sta_state(struct ieee80211_hw *hw,
 	return __rtw89_ops_sta_state(hw, vif, sta, old_state, new_state);
 }
 
+static bool rtw89_is_usb_ap(struct rtw89_dev *rtwdev,
+			    struct ieee80211_vif *vif)
+{
+	if (rtwdev->hci.type != RTW89_HCI_TYPE_USB)
+		return false;
+
+	/* vif == NULL means global flush; USB global MAC flush also times out. */
+	if (!vif)
+		return true;
+
+	return vif->type == NL80211_IFTYPE_AP;
+}
+
 static int rtw89_ops_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 			     struct ieee80211_vif *vif,
 			     struct ieee80211_sta *sta,
@@ -979,7 +992,9 @@ static int rtw89_ops_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 		flush_work(&rtwdev->txq_work);
 		rtw89_hci_flush_queues(rtwdev, BIT(rtwdev->hw->queues) - 1,
 				       false);
-		rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, false);
+		if (!rtw89_is_usb_ap(rtwdev, vif))
+			rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1,
+					    false);
 		ret = rtw89_cam_sec_key_del(rtwdev, vif, sta, key, true);
 		if (ret) {
 			rtw89_err(rtwdev, "failed to remove key from sec cam\n");
@@ -1098,8 +1113,12 @@ static void rtw89_ops_flush(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 
 	if (drop && !RTW89_CHK_FW_FEATURE(NO_PACKET_DROP, &rtwdev->fw))
 		__rtw89_drop_packets(rtwdev, vif);
-	else
+	else if (!rtw89_is_usb_ap(rtwdev, vif))
 		rtw89_mac_flush_txq(rtwdev, queues, drop);
+	else
+		rtw89_debug(rtwdev, RTW89_DBG_TXRX,
+			    "skip MAC flush for USB AP queues=0x%x drop=%d\n",
+			    queues, drop);
 }
 
 struct rtw89_iter_bitrate_mask_data {
