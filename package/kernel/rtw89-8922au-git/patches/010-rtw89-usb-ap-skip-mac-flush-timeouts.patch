From: rtw89-usb-ap-fix <local@patch>
Date: Fri, 15 May 2026 11:40:00 +0800
Subject: [PATCH] rtw89: skip MAC flush timeout paths for USB mode

RTL8922AU on Raspberry Pi 4/iStoreOS can reliably hit "timed out to
flush queues" from MAC-level DLE flushes while running over USB. The
key-disable path was not enough; mac80211 also calls ops_flush during
station teardown, and core_stop can hit the same MAC-level flush while
reloading Wi-Fi.

USB has no HCI queue flush hook in this driver, and the DLE empty poll is
the function that emits the timeout. Skip rtw89_mac_flush_txq() for USB
teardown paths. This avoids corrupting MAC/DLE state after client
disconnects, which otherwise can stop beaconing and make the SSID
disappear.
---
diff --git a/mac.c b/mac.c
--- a/mac.c
+++ b/mac.c
@@ -6261,6 +6261,9 @@ void rtw89_mac_flush_txq(struct rtw89_dev *rtwdev, u32 queues, bool drop)
 	if (!test_bit(RTW89_FLAG_POWERON, rtwdev->flags))
 		return;
 
+	if (rtwdev->hci.type == RTW89_HCI_TYPE_USB)
+		return;
+
 	ret = read_poll_timeout(dle_is_txq_empty, empty, empty,
 				10000, 200000, false, rtwdev);
 	if (ret && !drop && (rtwdev->total_sta_assoc || rtwdev->scanning))
diff --git a/core.c b/core.c
--- a/core.c
+++ b/core.c
@@ -5912,7 +5912,8 @@ void rtw89_core_stop(struct rtw89_dev *rtwdev)
 
 	rtw89_btc_ntfy_poweroff(rtwdev);
 	rtw89_hci_flush_queues(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
-	rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
+	if (rtwdev->hci.type != RTW89_HCI_TYPE_USB)
+		rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, true);
 	rtw89_hci_stop(rtwdev);
 	rtw89_hci_deinit(rtwdev);
 	rtw89_mac_pwr_off(rtwdev);
diff --git a/mac80211.c b/mac80211.c
--- a/mac80211.c
+++ b/mac80211.c
@@ -954,6 +954,11 @@ static int rtw89_ops_sta_state(struct ieee80211_hw *hw,
 	return __rtw89_ops_sta_state(hw, vif, sta, old_state, new_state);
 }
 
+static bool rtw89_is_usb(struct rtw89_dev *rtwdev)
+{
+	return rtwdev->hci.type == RTW89_HCI_TYPE_USB;
+}
+
 static int rtw89_ops_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 			     struct ieee80211_vif *vif,
 			     struct ieee80211_sta *sta,
@@ -979,7 +984,9 @@ static int rtw89_ops_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
 		flush_work(&rtwdev->txq_work);
 		rtw89_hci_flush_queues(rtwdev, BIT(rtwdev->hw->queues) - 1,
 				       false);
-		rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1, false);
+		if (!rtw89_is_usb(rtwdev))
+			rtw89_mac_flush_txq(rtwdev, BIT(rtwdev->hw->queues) - 1,
+					    false);
 		ret = rtw89_cam_sec_key_del(rtwdev, vif, sta, key, true);
 		if (ret) {
 			rtw89_err(rtwdev, "failed to remove key from sec cam\n");
@@ -1098,8 +1105,12 @@ static void rtw89_ops_flush(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
 
 	if (drop && !RTW89_CHK_FW_FEATURE(NO_PACKET_DROP, &rtwdev->fw))
 		__rtw89_drop_packets(rtwdev, vif);
-	else
+	else if (!rtw89_is_usb(rtwdev))
 		rtw89_mac_flush_txq(rtwdev, queues, drop);
+	else
+		rtw89_debug(rtwdev, RTW89_DBG_TXRX,
+			    "skip MAC flush for USB queues=0x%x drop=%d\n",
+			    queues, drop);
 }
 
 struct rtw89_iter_bitrate_mask_data {
